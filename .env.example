# copy this file to .env and set your own long random value
AUTH_SECRET=change-this-to-a-long-random-string

# set to true when the site is served over https
COOKIE_SECURE=false

# Meaning-based matching of similar doubts (optional, uses a local Ollama)
# EMBED_URL=http://localhost:11434
# EMBED_MODEL=nomic-embed-text
# SIMILARITY_THRESHOLD=0.65
